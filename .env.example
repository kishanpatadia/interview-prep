# Anthropic (unused unless you switch structuredClaude.js back to Claude)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Google Gemini (generation + grading — free tier via https://aistudio.google.com/apikey)
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-3.6-flash

# Voyage AI (embeddings for RAG retrieval — https://voyageai.com)
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3-lite

# App
PORT=3000
DB_PATH=./data/prep.db

# Seeding
SEED_TOPIC=Adobe Commerce (Magento) Architect-level interview prep
SEED_COUNT=70

# Demo safety limits
DAILY_CLAUDE_CALL_LIMIT=50
RATE_LIMIT_PER_IP_PER_HOUR=15

# Admin (POST /admin/seed — for platforms without shell access, e.g. Render free tier)
ADMIN_SEED_SECRET=
